0	string		sx,catson-gpio	SpaceX Catson device tree binding (Gen 2/3 flat dish)
0	string		st,catson-sdhci	SpaceX Catson eMMC controller DT binding
0	string		uterm_catapult	SpaceX Catapult user terminal variant (Gen 4 HP)
0	string		SPACEX_CATSON_UTERM	SpaceX Catson user terminal boot image
0	string		SPACEX_CATSON_TRANSCEIVER	SpaceX Catson transceiver firmware
0	string		satellite_starlink_point_release	SpaceX Gauntlet CI pipeline tag
0	string		ssh://git@stash:7999/sat/satcode.git	SpaceX satcode.git repository reference

