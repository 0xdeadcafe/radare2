# =============================================================================

0	string		/dev/stsafe_i2c		SpaceX STSafe-A110 HSM device (connection_manager)
0	string		/run/stsafe_cipher	SpaceX STSafe cipher output (setup_stsafe_identity)
0	string		/run/stsafe_leaf.pem	SpaceX STSafe leaf cert output (setup_stsafe_identity)
