# =============================================================================
# Modbus RTU / TCP (industrial, PLC communication)
# Already has string matches above; add byte-level TCP ADU detection
# =============================================================================
# Modbus TCP: transaction ID (2B) + protocol ID 0x0000 (2B) + length (2B) + unit ID (1B)
2	beshort	0x0000	Modbus TCP ADU (protocol identifier = 0x0000)

