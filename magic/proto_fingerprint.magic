# proto_fingerprint.magic — Protocol handler identification in firmware binaries
#
# Identifies which network protocols a binary implements by scanning for
# characteristic string constants and byte sequences that protocol handlers
# embed in their code/data sections.
#
# Use from r2: /m ~/.local/share/radare2/magic/proto_fingerprint.magic
# Or from a profile: /m magic/proto_fingerprint.magic
#
# Install: cp proto_fingerprint.magic ~/.local/share/radare2/magic/
#
# When a hit is found, the offset points to the string/constant in the binary.
# Cross-reference it (axt @ <offset>) to find the handling function.

# =============================================================================
# DJI DUPC 0x55 Protocol
# Wi-Fi modules: P3C/P3S/P3_4K m0700, m2700
# Reference: skel/.local/share/radare2/docs/protocols/dji-dupc-0x55.md
# =============================================================================
0	string	process_packet	DJI DUPC protocol handler (process_packet)
0	string	dji_printf	DJI firmware logging (dji_printf)
0	string	cmd_set	DJI DUPC command set field
0	string	DUPC	DJI DUPC protocol string
# DJI DUPC magic + length header: 0x55 <len_lo> <len_hi:6|ver:2>
0	string	\x55\x0f\x04	DJI DUPC 0x55 packet header (magic=0x55)

