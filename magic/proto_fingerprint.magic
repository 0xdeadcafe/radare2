0	string		SpaceX.API.Device.Services.Unlock	SpaceX UnlockService gRPC (root SSH key injection)

# Go protobuf package paths (embedded in static Go binaries)
0	string		spacex.com/sx_command	SpaceX SensitiveCommand gRPC package (Go)
0	string		spacex.com/security/catapult_provisioning	SpaceX Catapult provisioning gRPC (Go)

